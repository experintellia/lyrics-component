{
  "name": "@experintellia/lyrics",
  "version": "0.0.0",
  "description": "React lyrics display + sync editor (LRC). No fetching, no audio ownership.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lrc": {
      "types": "./dist/lrc.d.ts",
      "import": "./dist/lrc.js"
    },
    "./style.css": "./dist/lyrics.css"
  },
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode lib && tsc -p tsconfig.build.json",
    "build:demo": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "screenshots": "playwright test -c playwright.screenshots.config.ts"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "packageManager": "pnpm@11.10.0",
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  }
}
